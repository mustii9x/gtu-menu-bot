# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather
BOT_TOKEN=

# Your own Telegram chat ID (message @userinfobot to find it). Admin commands only work from here.
ADMIN_CHAT_ID=

# Vision LLM used to read the monthly menu picture (Anthropic API key)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Optional
# DAILY_SEND_TIME=07:30
# MENU_DIR=data/menus
# DB_PATH=data/users.db
